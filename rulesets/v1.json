{
  "ruleset_version": "v1",
  "registry_version": "v1",
  "rules": [
    {"rule_id": "CRIT-001", "version": 1, "title": "Critical result without documented response",
     "category": "critical-observation-unacknowledged", "lens": "completeness", "default_tier": 1,
     "owner_routing": "responsible_clinician", "enabled": true, "protected_floor": true, "registry_term_kinds": ["analyte"],
     "reason_template": "{source_label} records {claim_quote}. No later review, repeat, treatment, escalation or transfer for this result is documented in the supplied sources up to {cutoff_label}.",
     "question_template": "Was the critical {subject_label} reviewed or repeated?"},
    {"rule_id": "ALG-001", "version": 1, "title": "Conflicting allergy documentation",
     "category": "allergy-conflict", "lens": "contradiction", "default_tier": 1,
     "owner_routing": "responsible_clinician_plus_pharmacy", "enabled": true, "protected_floor": true, "registry_term_kinds": ["allergen", "drug_class"],
     "reason_template": "{claim_source_label} states {claim_quote} while {counter_source_label} names {counter_quote}.",
     "question_template": "Which allergy entry is correct?"},
    {"rule_id": "DOSE-001", "version": 1, "title": "Dose differs between sources",
     "category": "dose-discrepancy", "lens": "consistency", "default_tier": 2,
     "owner_routing": "responsible_clinician_plus_pharmacy", "enabled": true, "protected_floor": true, "registry_term_kinds": ["drug"],
     "reason_template": "{claim_source_label} records {claim_quote}; {counter_source_label} records {counter_quote}. No explicit change links them.",
     "question_template": "Which {subject_label} dose is current?"},
    {"rule_id": "DOSE-002", "version": 1, "title": "Dose not recognised by the checker",
     "category": "unparsed-dose", "lens": "completeness", "default_tier": 3,
     "owner_routing": "source_note_owner", "enabled": true, "protected_floor": true, "registry_term_kinds": ["drug"],
     "reason_template": "{source_label} contains {claim_quote}, which the checker could not attach to a medication regimen, so it has not been compared.",
     "question_template": "Which medication does {claim_quote} belong to?"},
    {"rule_id": "PEND-001", "version": 1, "title": "Pending item without owner or timing",
     "category": "pending-action-owner-timing", "lens": "completeness", "default_tier": 2,
     "owner_routing": "single_source_owner_else_responsible", "enabled": true, "protected_floor": false, "registry_term_kinds": ["test", "analyte"],
     "reason_template": "{source_label} records {claim_quote} without an explicit {missing_label} in the supplied sources.",
     "question_template": "Who owns the pending {subject_label} result?"},
    {"rule_id": "PDF-001", "version": 1, "title": "Document text could not be fully read",
     "category": "incomplete-extraction", "lens": "completeness", "default_tier": 2,
     "owner_routing": "source_note_owner", "enabled": true, "protected_floor": true, "registry_term_kinds": [],
     "reason_template": "{source_label} has extraction status {extraction_status}. Its content has not been checked; answers about absent documentation are limited until it is reviewed manually or by approved OCR.",
     "question_template": "Has {source_label} been reviewed manually or by approved OCR?"},
    {"rule_id": "DIFF-001", "version": 1, "title": "Possibly copied-forward statement",
     "category": "possible-copied-forward-text", "lens": "continuity", "default_tier": 3,
     "owner_routing": "source_note_owner", "enabled": true, "protected_floor": false, "registry_term_kinds": ["status"],
     "reason_template": "{source_label} repeats {claim_quote} from {origin_source_label}; {counter_source_label} records {counter_quote} in between.",
     "question_template": "Is the {source_time_label} {claim_quote} statement current?"},
    {"rule_id": "OWN-001", "version": 1, "title": "No responsible clinician recorded",
     "category": "no-responsible-clinician", "lens": "closure", "default_tier": 1,
     "owner_routing": "responsible_clinician", "enabled": true, "protected_floor": true, "registry_term_kinds": [],
     "reason_template": "No responsible clinician is recorded for this encounter; Tier 1 items are routed to the attending clinician until one is recorded.",
     "question_template": "Who is the responsible clinician for this encounter?"},
    {"rule_id": "DET-001", "version": 1, "title": "Reassurance recorded after a deterioration marker",
     "category": "reassurance-after-deterioration", "lens": "continuity", "default_tier": 1,
     "owner_routing": "responsible_clinician", "enabled": true, "protected_floor": true, "registry_term_kinds": ["status", "analyte"],
     "reason_template": "{source_label} records {claim_quote} after {counter_source_label} recorded {counter_quote}, with no clinician review documented in between.",
     "question_template": "Is the {source_time_label} {claim_quote} statement current?"},
    {"rule_id": "LAT-001", "version": 1, "title": "Left and right differ between sources",
     "category": "laterality-conflict", "lens": "contradiction", "default_tier": 1,
     "owner_routing": "responsible_clinician", "enabled": false, "protected_floor": true, "registry_term_kinds": ["site"],
     "reason_template": "{claim_source_label} records {claim_quote}; {counter_source_label} records {counter_quote}.",
     "question_template": "Which side is correct?"},
    {"rule_id": "META-001", "version": 1, "title": "Source metadata incomplete",
     "category": "incomplete-metadata", "lens": "completeness", "default_tier": 3,
     "owner_routing": "source_note_owner", "enabled": false, "protected_floor": false, "registry_term_kinds": [],
     "reason_template": "{source_label} is missing {missing_label}.", "question_template": null},
    {"rule_id": "NEXT-001", "version": 1, "title": "No next step recorded",
     "category": "no-next-step", "lens": "closure", "default_tier": 3,
     "owner_routing": "source_note_owner", "enabled": false, "protected_floor": false, "registry_term_kinds": [],
     "reason_template": "{source_label} records no next step.", "question_template": null}
  ],
  "question_templates": [
    {"template_id": "q_responsible_clinician", "rank": 1, "text": "Who is the responsible clinician for this encounter?",
     "trigger": {"kind": "flag_rule", "rule_id": "OWN-001"}, "answer_mode": "human_review"},
    {"template_id": "q_allergy_which_correct", "rank": 2, "text": "Which allergy entry is correct?",
     "trigger": {"kind": "flag_rule", "rule_id": "ALG-001"}, "answer_mode": "conflict_state"},
    {"template_id": "q_crit_response", "rank": 3, "text": "Was the critical {subject_label} reviewed or repeated?",
     "trigger": {"kind": "critical_observation"}, "answer_mode": "absence_search",
     "search_term_keys": ["{subject}", "cue:response_review", "cue:response_repeat", "cue:response_treatment", "cue:response_escalation", "cue:response_transfer"]},
    {"template_id": "q_ecg_documented", "rank": 4, "text": "Is an ECG documented for this episode?",
     "trigger": {"kind": "critical_observation", "analyte_keys": ["analyte:potassium"]}, "answer_mode": "absence_search",
     "search_term_keys": ["test:ecg"]},
    {"template_id": "q_dose_current", "rank": 5, "text": "Which {subject_label} dose is current?",
     "trigger": {"kind": "flag_rule", "rule_id": "DOSE-001"}, "answer_mode": "conflict_state"},
    {"template_id": "q_pending_owner", "rank": 6, "text": "Who owns the pending {subject_label} result?",
     "trigger": {"kind": "flag_rule", "rule_id": "PEND-001"}, "answer_mode": "absence_search",
     "search_term_keys": ["{subject}", "cue:owner"]},
    {"template_id": "q_pdf_manual_review", "rank": 7, "text": "Has {source_label} been reviewed manually or by approved OCR?",
     "trigger": {"kind": "flag_rule", "rule_id": "PDF-001"}, "answer_mode": "human_review"},
    {"template_id": "q_carried_forward_current", "rank": 8, "text": "Is the {source_time_label} {claim_quote} statement current?",
     "trigger": {"kind": "flag_rule", "rule_id": "DIFF-001"}, "answer_mode": "human_review"},
    {"template_id": "q_unparsed_dose", "rank": 9, "text": "Which medication does {claim_quote} belong to?",
     "trigger": {"kind": "flag_rule", "rule_id": "DOSE-002"}, "answer_mode": "human_review"}
  ]
}
